# API Keys for Data Pipeline
# DO NOT COMMIT THIS FILE TO GIT - It's already in .gitignore

# News API Key (for fetching news articles)
NEWS_API_KEY=your_key_here

# SEC API Key (for fetching SEC filings)
SEC_API_KEY=your_key_here

# Polygon.io API Key (for financial data)
POLYGON_API_KEY="your_key_here"

# Company to fetch data for
COMPANY=Apple Inc

# Enable/disable SEC filing fetching
FETCH_SEC_FILINGS=true

# Optional: Email alerts configuration
# ALERT_EMAIL_SENDER=your-email@gmail.com
# SMTP_PASSWORD=your-password

# Optional: Slack webhook for alerts
# SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL

