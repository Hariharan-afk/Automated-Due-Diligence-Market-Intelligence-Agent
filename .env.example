# .env.example
# Copy this file to .env and fill in your values

# API Keys
QUERY_PARSER_MODEL_API_KEY="your_api_key"
SEC_API_KEY="b2b3587f4055e7b21e1e5256d641c9ad941f315e2479cc936022649341bddf11"
GROQ_API_KEY="your_api_key"

# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=researcher_db
DB_USER=postgres
DB_PASSWORD=#Enter your Password

# Vector Database (Qdrant)
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_COLLECTION=sec_filings

# Embedding Model
EMBEDDING_MODEL=BAAI/bge-large-en-v1.5
EMBEDDING_DIMENSION=1024

# Chunking Configuration
TEXT_CHUNK_SIZE=500
TEXT_CHUNK_OVERLAP=75

# LLM for Table Summaries
TABLE_SUMMARY_MODEL=llama-3.3-70b-versatile
TABLE_SUMMARY_TEMPERATURE=0.3
TABLE_SUMMARY_MAX_TOKENS=200

# Rate Limiting
SEC_API_RATE_LIMIT=8

# Logging
LOG_LEVEL=INFO